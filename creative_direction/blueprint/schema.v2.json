  "database": { "selection": "existing", "id": "6a4bead3002f1426a8ee", "name": "orin-database-dev", "create": false, "enabled": true },
  "auth": {
    "mode": "guest_then_email_password",
    "stableOwnerId": "appwrite_account_id",
    "handle": { "private": true, "unique": false, "loginIdentifier": false, "minLength": 3, "maxLength": 32 },
