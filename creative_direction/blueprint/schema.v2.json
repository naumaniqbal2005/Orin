    "functionOwnedTablePermissions": [],
    "defaultOwnerRowPermissions": ["read(\"user:{ownerId}\")", "update(\"user:{ownerId}\")", "delete(\"user:{ownerId}\")"],
    "notes": [
      "No private table grants table-wide read, update, or delete.",
      "Direct client creates attach permissions for the current Appwrite account ID.",
      "Functions derive the account ID from authenticated execution and never trust a submitted userId.",
      "Function-created rows receive only the owner permissions declared by their table."
    ]
